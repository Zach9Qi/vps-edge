# 复制为 .env 后修改：cp .env.example .env && chmod 600 .env
# 注意：该文件含 Cloudflare Token，不要提交到任何仓库

# ---------- 本机角色 ----------
# edge = 完整节点（默认）：REALITY + 伪装站 + 网站，手机直接连
# exit = 纯内网出口：只给同一内网里的入口机当出口，不装 nginx / 证书 / 伪装站，
#        不需要填下面的 REALITY / 证书 / Cloudflare，但必须填 EXIT_LISTEN
EDGE_ROLE=edge

# ---------- REALITY ----------
# 偷自己的域名：一个专用子域名，A/AAAA 指向本机（本方案所有域名都用 Cloudflare 灰云 / 仅 DNS）
REALITY_SNI=www.example.com
# 该 SNI 所属的根域名（证书按根域名签发：example.com + *.example.com）
REALITY_CERT_DOMAIN=example.com
# 客户端里显示的节点名，可以用中文和 emoji（文件请保存为 UTF-8）
# 名字里有空格时要加引号，例如 NODE_NAME="香港 01"
NODE_NAME=美国01

# 伪装站应用 apps/decoy 在本机监听的端口（只绑定 127.0.0.1）
# edge 会按这个端口自动启动应用并生成反代配置；修改后运行 edge apply 生效。不能用 443 / 8443 / 10443
DECOY_PORT=3000

# ---------- 证书 ----------
# Let's Encrypt 账户邮箱
ACME_EMAIL=admin@example.com
# Cloudflare API Token
# 权限：Zone -> DNS -> Edit，Zone -> Zone -> Read；Zone Resources 只选你的域名
CF_Token=

# ---------- 链式代理（可选，详见 README 第 8 节）----------
# 上游：填了以后，本机的代理流量全部经这个上游出去，本机不直连任何网站；留空 = 直接出网
# 推荐用 edge upstream '<链接>' 设置（会先测试，通过才启用）；手动填写时链接两边必须加单引号
# 支持 vless:// ss:// socks5:// http:// https://
UPSTREAM=
# 内网入口：给同一内网里的入口机用（Shadowsocks 2022，只监听内网 IP）；留空 = 不开
# 格式：本机内网IP:端口，例如 10.0.0.2:23456；推荐用 edge internal 设置（会列出本机的内网 IP）
# 安全组 / 防火墙里放行这个端口的 tcp 和 udp，来源只填入口机的内网 IP 或内网网段
EXIT_LISTEN=

# ---------- 主机 ----------
# nginx 是否监听 IPv6 的 443：auto / true / false
ENABLE_IPV6=auto

# ---------- 镜像（生产环境建议固定版本号）----------
NGINX_IMAGE=nginx:stable-alpine
# Xray 官方镜像：latest = 最新正式版（不含 Pre-release），edge update 时自动升级
# 想固定版本：改成 ghcr.io/xtls/xray-core:<版本号，不带 v>，版本见 https://github.com/XTLS/Xray-core/releases
# 不要用 :pre-release 标签，它会跟着测试版走
XRAY_IMAGE=ghcr.io/xtls/xray-core:latest
